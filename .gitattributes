# Keep LF in the repo and the working tree (tools and generators write LF;
# avoids CRLF churn with core.autocrlf=true on Windows).
* text=auto eol=lf
*.wav binary
*.zip binary
*.pdf binary
# Test pages are inputs byte for byte (hostile.8tml has CR, NUL and raw UTF-8)
apps/zx-vvv/testpages/*.8tml -text
