# Host build (CMake)
/build/

# ESP-IDF
/esp32/build/
/esp32/sdkconfig
/esp32/sdkconfig.old
/esp32/managed_components/
/esp32/dependencies.lock

# KiCad local/cache files
*-backups/
fp-info-cache
*.kicad_prl
*.lck
.history/
# generated by kicad-cli during checks (see hardware/kicad/check_netlist.py)
/hardware/kicad/*.net
/hardware/kicad/*.rpt
/hardware/kicad/*.dsn
/hardware/kicad/*.ses
/hardware/fab/tmp/
__pycache__/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Kept local, not published
CLAUDE.local.md
/*.wav
# the 8TML spec package (license undecided): get it from the author
apps/zx-vvv/spec/*
!apps/zx-vvv/spec/GET-THE-SPEC.md
# EasyEDA footprint data, downloaded by hardware/kicad/jlc_fit.py
hardware/kicad/easyeda/
# generated / personal order archives, except the current board's Gerbers
